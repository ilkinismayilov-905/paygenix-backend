# Paygenix web: the SPA plus a same-origin proxy to the API (ADR 0001). Terminate TLS in front of this (or add an ssl
# server here): the refresh cookie is Secure, so production must be https.
# The public port, from the Host the browser used (else the scheme's default): Tomcat rebuilds the request URL from
# X-Forwarded-Proto/-Port, and the API compares it with the Origin header to recognise same-origin calls.
map $http_host $forwarded_port {
    ~:(?<port>[0-9]+)$ $port;
    default $default_port;
}
map $scheme $default_port {
    https 443;
    default 80;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    # KYC documents and promo videos (the API refuses larger ones itself)
    client_max_body_size 11m;

    # the API and the Google sign-in round trip; the app trusts X-Forwarded-* only from this proxy (TRUSTED_PROXIES)
    location ~ ^/(api|oauth2/authorization|login/oauth2)/ {
        include /etc/nginx/conf.d/security-headers.inc;
        proxy_pass ${BACKEND_URL};
        # with the port: the API compares the Origin header with this host to tell same-origin requests
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $forwarded_port;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_read_timeout 60s;
    }

    # hashed build files never change: cache them for a year
    location /assets/ {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # every other path is a client route; index.html is never cached, so a deploy is picked up on the next load
    location / {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
