# Paygenix web: the SPA plus a same-origin proxy to the API (ADR 0001). TLS is terminated in front of this, by the
# Caddy edge (compose profile "tls", docs/DEPLOY.md): the refresh cookie is Secure, so production must be https.

# Behind the edge, the client's address and scheme come from it (X-Forwarded-For / -Proto), believed only from
# EDGE_PROXY, the edge's fixed address. Without an edge both stay what nginx sees, so a client cannot fake them.
set_real_ip_from ${EDGE_PROXY};
real_ip_header X-Forwarded-For;
geo $realip_remote_addr $from_edge {
    default 0;
    ${EDGE_PROXY} 1;
}
map "$from_edge:$http_x_forwarded_proto" $client_scheme {
    "1:https" https;
    "1:http" http;
    default $scheme;
}

# The public port, from the Host the browser used (else the scheme's default): Tomcat rebuilds the request URL from
# X-Forwarded-Proto/-Port, and the API compares it with the Origin header to recognise same-origin calls.
map $http_host $forwarded_port {
    ~:(?<port>[0-9]+)$ $port;
    default $default_port;
}
map $client_scheme $default_port {
    https 443;
    default 80;
}

# the access log carries the request id that is also passed to the API (X-Request-Id) and printed in its logs
log_format paygenix '$remote_addr - [$time_local] "$request" $status $body_bytes_sent $request_time '
                    '"$http_referer" "$http_user_agent" rid=$request_id';

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    access_log /var/log/nginx/access.log paygenix;

    # KYC documents and promo videos (the API refuses larger ones itself)
    client_max_body_size 11m;

    # the API and the Google sign-in round trip; the app trusts X-Forwarded-* only from this proxy (TRUSTED_PROXIES)
    location ~ ^/(api|oauth2/authorization|login/oauth2)/ {
        include /etc/nginx/conf.d/security-headers.inc;
        proxy_pass ${BACKEND_URL};
        # with the port: the API compares the Origin header with this host to tell same-origin requests
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $client_scheme;
        proxy_set_header X-Forwarded-Port $forwarded_port;
        proxy_set_header X-Forwarded-Host $http_host;
        # nginx's own id replaces whatever the client sent, so log lines on both sides match
        proxy_set_header X-Request-Id $request_id;
        proxy_read_timeout 60s;
    }

    # hashed build files never change: cache them for a year
    location /assets/ {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # every other path is a client route; index.html is never cached, so a deploy is picked up on the next load
    location / {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
