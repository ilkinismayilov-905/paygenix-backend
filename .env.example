# Copy to .env and fill in. Never commit .env.
# Keys with a default in application.properties are commented out.

# --- Server ---
#SERVER_PORT=8000
APP_NAME=Paygenix
APP_BASE_URL=http://localhost:8000
APP_WEB_URL=http://localhost:3000
#FRONTEND_URL=http://localhost:3000
# Comma-separated. Default: localhost and 127.0.0.1 on ports 3000 and 5173. Production MUST set the real origin(s).
#CORS_ALLOWED_ORIGINS=https://app.example.com,https://www.example.com
#SWAGGER_ENABLED=false

# --- PostgreSQL (docker compose publishes it on host port 5455) ---
DB_NAME=paygenix
DB_URL=jdbc:postgresql://localhost:5455/paygenix
DB_USERNAME=paygenix
# required: also the Postgres superuser password in compose (the container will not start without it).
# Postgres reads DB_NAME/DB_USERNAME/DB_PASSWORD only when the pgdata volume is first created;
# to change them later use ALTER USER (user/password) or CREATE DATABASE (name), or remove the volume (deletes local data).
DB_PASSWORD=

# --- Redis ---
#REDIS_HOST=localhost
# host port compose publishes Redis on; the app container always uses redis:6379
#REDIS_PORT=6379

# --- JWT ---
# Random string, at least 32 bytes (used as-is, not decoded): openssl rand -base64 48
JWT_SECRET=
# lifetimes in seconds
JWT_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=1209600

# --- Card numbers ---
# Keys the HMAC used to look cards up by number; at least 32 bytes (used as-is): openssl rand -base64 48
# Back it up: it cannot be rotated without reissuing every card.
CARD_PAN_HMAC_KEY=
# 6-digit issuer BIN for new card numbers
#CARD_ISSUER_BIN=400000

# --- Fees (percent) ---
#FEE_COMMISSION_PERCENT=2.00
#FEE_CASHBACK_PERCENT=0.5

# --- Mail (SMTP) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_PROTOCOL=smtp
MAIL_USERNAME=
# Gmail app password, not the account password
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true

# --- Google sign-in ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/login/oauth2/code/google

# --- MinIO (local: docker compose --profile local up -d) ---
# used as-is by the app container too, so it must be reachable from there and from browsers (presigned URLs);
# localhost only works with the app on the host
MINIO_URL=http://localhost:9000
# also MinIO's root user/password in compose: user >= 3 chars, password >= 8 chars
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
STORY_EXPIRY_SECONDS=86400
STORY_PRESIGN_SECONDS=3600
